{
  "name": "agent-host-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist-client/index.js",
  "types": "./dist-client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-client/index.d.ts",
      "import": "./dist-client/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:types && vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "check:assets": "node scripts/check-assets.mjs",
    "smoke:package": "node -e \"import('./dist-client/index.js')\"",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/contract/**'",
    "test:contract": "vitest run test/contract",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --project=desktop --project=narrow",
    "test:a11y": "playwright test --project=accessibility",
    "test:performance": "playwright test --project=performance",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
